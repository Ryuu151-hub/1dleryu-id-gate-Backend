# Copy to .env.local for local `vercel dev` testing.
# In production, set these in Vercel -> Project -> Settings -> Environment Variables.

# Long random string only you know. Required by every /api/admin/* route.
ADMIN_SECRET=change-me-to-a-long-random-string

# KV_REST_API_URL and KV_REST_API_TOKEN are injected automatically once you
# link a Vercel KV database to this project — you do not need to set them
# by hand.
